{
  "name": "app-cbo",
  "productName": "App.CBO",
  "version": "0.1.0",
  "description": "Gestão do Curso Básico de Obras e Construção Civil",
  "main": "electron/main.js",
  "author": "App.CBO",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist": "vite build && electron-builder",
    "dev:web": "concurrently -k \"node --env-file-if-exists=.env server/dev-web.js\" \"vite\"",
    "build:demo": "vite build --config vite.demo.config.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "sql.js": "^1.13.0",
    "buffer": "^6.0.3"
  },
  "build": {
    "appId": "br.com.appcbo.desktop",
    "productName": "App.CBO",
    "files": [
      "electron/**",
      "src/core/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "engines": {
    "node": ">=22.9"
  }
}
